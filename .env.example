# Copia este archivo como ".env" (sin .example) y llena los datos.
# El archivo .env es secreto: NO lo subas a GitHub ni lo compartas.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=localpon

# --- Seguridad ---
# Texto largo y aleatorio; firma las sesiones.
JWT_SECRET=escribe-aqui-un-texto-largo-y-aleatorio

# --- Cuenta del propietario (se crea sola la primera vez que arranca con la base vacía) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Propietario

# --- Solo si la base de datos está en la nube (TiDB, Aiven...) ---
DB_PORT=3306
DB_SSL=false
